# ==============================================================================
# Hermes × Buzz: Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cognitive Plane: Model Provider Keys
# ------------------------------------------------------------------------------
# Set to run with any model provider (OpenAI, Groq, DeepSeek, OpenRouter, Ollama, GLM, or local vLLM).
# If left empty, the agent will fall back to local MockLLM execution.
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GLM_API_KEY=your_glm_api_key_here
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Control Plane: Nostr Relay Configuration
# ------------------------------------------------------------------------------
# Points to the strfry Nostr relay instance used for NIP-17 signaling.
RELAY_URL=ws://nostr-relay:7777

# ------------------------------------------------------------------------------
# 3. Media Plane: LiveKit SFU (Multi-Party Huddles)
# ------------------------------------------------------------------------------
# LiveKit Server connection URL and signing keys for WebRTC participant tokens.
LIVEKIT_URL=ws://livekit-sfu:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# 4. Media Plane: coturn TURN Server (NAT Traversal)
# ------------------------------------------------------------------------------
# Secret key used to generate ephemeral credentials for WebRTC ice clients.
COTURN_SECRET=coturnsecret
COTURN_REALM=localhost

# ------------------------------------------------------------------------------
# 5. Local Hardware & Storage Configuration
# ------------------------------------------------------------------------------
# Host path to store cached huggingface/faster-whisper and piper model files.
# Allows sharing weight directories across container restarts.
MODEL_CACHE_DIR=./models
PERSISTENT_MEMORY_DIR=./memory
AGENT_KEYSTORE_DIR=./keys
